{
    "version": 4,
    "configurations": [
        {
            // cpptools auto-selects this configuration on macOS by name.
            "name": "Mac",
            // Preferred source of truth: exact per-file flags (including the
            // Qt -iframework/-isystem paths) as CMake actually invokes the
            // compiler. Regenerated by `cmake --build build` or on configure.
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            // Fallback used only if compile_commands.json is missing (e.g.
            // before the first CMake configure) or for files it doesn't
            // cover. ${env:CMAKE_PREFIX_PATH} is the same variable exported
            // for the CMake configure itself (see .vscode/settings.json) —
            // set it once and both agree on the same Qt install.
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/build/avxto-wallet-manager_autogen/include",
                "${env:CMAKE_PREFIX_PATH}/lib/QtCore.framework/Headers",
                "${env:CMAKE_PREFIX_PATH}/lib/QtGui.framework/Headers",
                "${env:CMAKE_PREFIX_PATH}/lib/QtWidgets.framework/Headers",
                "${env:CMAKE_PREFIX_PATH}/lib/QtNetwork.framework/Headers",
                "${env:CMAKE_PREFIX_PATH}/mkspecs/macx-clang",
                "${env:CMAKE_PREFIX_PATH}/include"
            ],
            "macFrameworkPath": [
                "${env:CMAKE_PREFIX_PATH}/lib"
            ],
            "defines": [
                "QT_CORE_LIB",
                "QT_GUI_LIB",
                "QT_WIDGETS_LIB",
                "QT_NETWORK_LIB",
                "QT_NO_CAST_FROM_ASCII",
                "QT_NO_CAST_TO_ASCII",
                "QT_DISABLE_DEPRECATED_UP_TO=0x060500"
            ],
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "${default}"
        },
        {
            // cpptools auto-selects this configuration on Linux by name.
            "name": "Linux",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/build/avxto-wallet-manager_autogen/include",
                "${env:CMAKE_PREFIX_PATH}/include",
                "${env:CMAKE_PREFIX_PATH}/include/QtCore",
                "${env:CMAKE_PREFIX_PATH}/include/QtGui",
                "${env:CMAKE_PREFIX_PATH}/include/QtWidgets",
                "${env:CMAKE_PREFIX_PATH}/include/QtNetwork",
                "${env:CMAKE_PREFIX_PATH}/mkspecs/linux-g++",
                "/usr/include"
            ],
            "defines": [
                "QT_CORE_LIB",
                "QT_GUI_LIB",
                "QT_WIDGETS_LIB",
                "QT_NETWORK_LIB",
                "QT_NO_CAST_FROM_ASCII",
                "QT_NO_CAST_TO_ASCII",
                "QT_DISABLE_DEPRECATED_UP_TO=0x060500"
            ],
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "${default}"
        }
    ]
}
