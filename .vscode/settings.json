{
    // Driven entirely by CMake Presets, so this file has no machine- or
    // OS-specific paths and is safe to commit/sync between macOS, Linux and
    // Windows checkouts.
    //
    // CMakePresets.json (tracked) is just a shared, empty-of-paths base.
    // Run ./scripts/build.sh once (and again whenever your Qt install
    // changes) to generate CMakeUserPresets.json — a gitignored "dev" preset
    // with your machine's Qt location, generator and build type — which
    // CMake Tools then picks up automatically below. See
    // notes/initiallog.txt and CMakePresets.json for the full rationale.
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,

    // Let cpptools ask CMake Tools for include paths/defines per file
    // instead of relying solely on the static fallback in
    // c_cpp_properties.json.
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json"
}
